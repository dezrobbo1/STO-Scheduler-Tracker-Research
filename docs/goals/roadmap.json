  "rules": [
    {
      "id": "PR-core-stdlib-only",
      "summary": "sto.core depends on the standard library alone, so hashing stays testable without a database and no validation library can reorder a field and move a hash",
      "owed_to": "S1",
      "status": "live",
      "live_when": {
        "kind": "path_exists",
        "path": "src/sto/core"
      },
      "enforced_by": "tests/test_core_is_stdlib_only.py"
    },
    {
      "id": "PR-no-schedule-content",
      "summary": "Real customer schedule content and credentials never enter the repository",
      "owed_to": "S1",
      "status": "live",
      "live_when": {
        "kind": "path_exists",
        "path": "docs"
      },
      "enforced_by": "tests/test_docs_carry_no_schedule_content.py"
    },
    {
      "id": "PR-conformance-suite",
      "summary": "Engine claims are bounded by the 50-case semantic conformance suite as well as by the file oracle",
      "owed_to": "S3",
      "status": "pending",
      "live_when": {
        "kind": "path_exists",
        "path": "src/sto/conformance"
      },
      "enforced_by": null
    },
    {
      "id": "PR-evidence-register",
      "summary": "A writer claims native-evidence-derived only when the register holds an entry for that target system and that application build",
      "owed_to": "I13",
      "status": "pending",
      "live_when": {
        "kind": "path_exists",
        "path": "docs/evidence/register.json"
      },
      "enforced_by": null
    },
    {
      "id": "PR-approved-forecast",
      "summary": "The live schedule may change automatically; the exported forecast moves only through supervisor then planner review",
      "owed_to": "PL6",
      "status": "pending",
      "live_when": {
        "kind": "import_succeeds",
        "module": "sto.execution.review"
      },
      "enforced_by": null
    },
    {
      "id": "PR-migrations",
      "summary": "Schema changes are new versioned files under infra/migrations; an applied migration is never rewritten",
      "owed_to": "PL1",
      "status": "pending",
      "live_when": {
        "kind": "path_exists",
        "path": "infra/migrations"
      },
      "enforced_by": null
    },
    {
      "id": "PR-legacy-retirement",
      "summary": "sto.legacy is the oracle the new engine and the sidecar are checked against, and is deleted once that cross-check is green on every fixture",
      "owed_to": "I4",
      "status": "pending",
      "live_when": {
        "kind": "path_exists",
        "path": "src/sto/interchange"
      },
      "enforced_by": null
    }
  ]
}
